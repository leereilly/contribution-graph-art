{
  "name": "contribution-graph-art",
  "version": "1.0.0",
  "description": "Generate an animated contribution graph SVG with falling tetrominoes and optional logo overlay",
  "private": true,
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --outfile=dist/index.js",

    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^6.0.0",
    "@octokit/graphql": "^7.0.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "esbuild": "^0.20.1",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  }
}
